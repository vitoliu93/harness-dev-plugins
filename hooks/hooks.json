{
  "description": "skill-guard: redirect noisy inline skills to subagents. worktree-guard: enforce exit-safety order on git worktree remove. skill-atlas-guard: block a plugin-repo commit that edits a SKILL.md until skill-atlas re-runs (stale fleet-health gate). skill-path-fallback: deny a Bash command with an unexpanded ${CLAUDE_SKILL_DIR}/${CLAUDE_PLUGIN_ROOT} and tell the model how to resolve the real script path. learn-capture (Stop) + session-replay (SessionStart): the [LEARN] sedimentation loop — capture markers into .claude/LEARNED.md, replay last 5 at session start.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/skill-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/worktree-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/skill-atlas-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/skill-path-fallback.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/learn-capture.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-replay.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

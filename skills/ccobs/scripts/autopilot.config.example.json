{
  "limits": { "bundles": 3, "items": 5, "agentMinutes": 40, "runHours": 4, "retries": 2 },
  "roles": {
    "acceptance": [{ "alias": "<cheap-model>" }, { "alias": "<fallback-model>" }],
    "developer": [{ "alias": "<cheap-model>" }, { "alias": "<fallback-model>" }],
    "reviewer": [{ "alias": "<strong-model>", "effort": "medium" }, { "alias": "<fallback-model>" }]
  },
  "deployCmd": "<your-deploy-command> {targets}",
  "repos": {
    "example-web": { "path": "<path-to-repo>", "branch": "dev", "issue": true, "cloneDeps": true, "deploy": "web",
      "install": "npm ci",
      "listTests": "git ls-files 'src/*.test.ts'", "runTest": "npx vitest run {file}" },
    "example-api": { "path": "<path-to-repo>", "branch": "main", "bump": true,
      "install": "uv sync --frozen",
      "listTests": "git ls-files 'tests/test_*.py'", "runTest": "uv run --frozen pytest -q {file}" }
  }
}
